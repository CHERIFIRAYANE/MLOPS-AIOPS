# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Data files (large CSVs — regenerated by the pipeline) ─────────────────────
data/*.csv

# ── Trained model binaries (regenerated by training/train_model.py) ───────────
training/models/*.pkl
aiops-engine/models/*.pkl

# Keep feature list JSON (small, needed to run the engine without retraining)
!training/models/feature_list.json
!aiops-engine/models/feature_list.json

